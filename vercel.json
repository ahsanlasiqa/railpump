{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/viacheslavstarostin-action.mp3",
      "headers": {
        "Content-Type": "audio/mpeg",
        "Cache-Control": "public, max-age=31536000"
      },
      "dest": "/viacheslavstarostin-action.mp3"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
