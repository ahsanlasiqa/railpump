{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    {
      "src": "/viacheslavstarostin-action.mp3",
      "headers": {
        "Content-Type": "audio/mpeg",
        "Cache-Control": "public, max-age=31536000"
      },
      "dest": "/viacheslavstarostin-action.mp3"
    },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
